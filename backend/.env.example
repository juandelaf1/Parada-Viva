# Parada Viva API - entorno (no commitear secretos reales)
PORT=3001
NODE_ENV=development
# CORS: en producción usar orígenes explícitos (coma-separados)
CORS_ORIGINS=*
# HSTS solo tras TLS (true/false)
# HSTS=false
# QR firmado (HMAC+exp). En producción: secreto fuerte en secret manager.
# QR_SIGNING_SECRET=cambiar-en-produccion
# PUBLIC_BASE_URL=https://tu-dominio
# Privacidad: decimales coords ofuscadas (2~1.1km, 3~110m)
# COORD_OBFUSCATE_DECIMALS=3
# Ofuscar coords públicas (establecimientos) — false por defecto para no romper mapa; evaluar D8.
# OBFUSCATE_PUBLIC_COORDS=false
# Reportes agregados (stopgap D8; clave fuerte en secret manager). No exporta PII.
# REPORT_API_KEY=
# SQLite dev (default local)
DATABASE_URL="file:./dev.db"
# Producción (Postgres gestionada):
# DATABASE_URL="postgresql://user:password@host:5432/parada_viva?schema=public"
